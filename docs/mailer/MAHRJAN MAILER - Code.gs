    + 'tr.band td{color:' + C_.green + ';font-weight:700;text-align:left;border-bottom:1.5px solid ' + C_.dark + '}tr.sub td{background:' + C_.sub + ';font-weight:700}tr.grand td{background:' + C_.head + ';font-weight:700}'
    + 'td.r{color:' + C_.red + '}td.b{font-weight:700}.pg{page-break-before:always}</style>'; }
function head_(title, sub2, period) {
  return '<table style="width:100%;border-collapse:collapse;margin:0 0 10px"><tr><td style="width:90px;vertical-align:middle"><img src="data:image/jpeg;base64,' + MJ_LOGO + '" style="height:54px"></td>'
    + '<td style="text-align:center;vertical-align:middle"><div style="font-size:20px;font-weight:700;color:' + C_.green + '">MAHRJAN GENERAL TRADING LLC</div>'
    + '<div style="font-size:16px;font-weight:700;margin-top:1px">' + esc_(title) + '</div>' + (sub2 ? '<div style="font-size:12px;color:#6b7370;margin-top:1px">' + esc_(sub2) + '</div>' : '')
    + (period ? '<div style="font-size:12px;color:#6b7370">' + esc_(period) + '</div>' : '') + '</td><td style="width:90px"></td></tr></table>'; }
function doc_(body, landscape) { return '<html><head>' + css_(landscape) + '</head><body>' + body + '</body></html>'; }
function m2_(v) { var s = (Math.round((v || 0) * 100) / 100).toFixed(2), n = s.charAt(0) === '-'; if (n) s = s.slice(1); var p = s.split('.'); return (n ? '-' : '') + p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1]; }
function q_(v) { v = Math.round((v || 0) * 100) / 100; return String(v); }
function sg_(v) { v = Math.round((v || 0) * 100) / 100; return v > 0 ? '+' + v : String(v); }
function pc_(a, b) { return b > 0 ? (a / b * 100).toFixed(2) + '%' : '0.00%'; }
function unitName_(u) { return String(u || '').toUpperCase() === 'AJMAN' ? 'AJMAN' : 'AL QUOZ'; }

// ---------- 1. SALESMAN WISE SALES & DAMAGE ----------
function damageHtml_(D, units, per) {
  var F = ['ex','inc','dq','dv','wq','wv'], z = function () { return { ex: 0, inc: 0, dq: 0, dv: 0, wq: 0, wv: 0 }; }, add = function (a, m) { F.forEach(function (f) { a[f] += Number(m[f]) || 0; }); return a; };
  var row = function (m, lab, cls) { return '<tr' + (cls ? ' class="' + cls + '"' : '') + '><td class="l">' + esc_(lab) + '</td>' + [m2_(m.ex), m2_(m.inc), q_(m.dq), m2_(m.dv), q_(m.wq), m2_(m.wv), m2_(m.ex - m.dv), pc_(m.dv, m.ex), pc_(m.wv, m.ex)].map(function (v) { return '<td>' + v + '</td>'; }).join('') + '</tr>'; };
  var G = z(), body = units.map(function (u) { var T = z(), n = unitName_(u.unit);
    return '<tr class="band"><td colspan="10">' + n + ' UNIT</td></tr>' + u.rows.map(function (m) { add(T, m); return row(m, m.name === 'STORE SALE' ? 'STORE SALE (' + (n === 'AJMAN' ? 'Ajman' : 'Al Quoz') + ')' : m.name); }).join('') + (add(G, T), row(T, n + ' SUB TOTAL', 'sub')); }).join('');
  var p1 = head_('Salesman Wise Sales & Damage Report', '', 'Period: ' + per + ' | Values in AED') + '<table class="t"><tr>'
    + ['Salesman','Sales Value<br>(Excl VAT)','Sales Value<br>(Incl VAT)','Damage<br>Qty','Damage<br>Value','Waste<br>Qty','Waste<br>Value','Net Sales<br>After Damage','Damage %<br>of Sales','Waste %<br>of Sales'].map(function (h, i) { return '<th' + (i ? '' : ' class="l"') + '>' + h + '</th>'; }).join('') + '</tr>'
    + body + (units.length > 1 ? row(G, 'GRAND TOTAL', 'grand') : '') + '</table>';
  var names = {}; units.forEach(function (u) { u.items.forEach(function (it) { names[it.code] = it.name; }); });
  var codes = Object.keys(names).sort(function (a, b) { return names[a].localeCompare(names[b]); }), find = function (u, c) { for (var i = 0; i < u.items.length; i++) if (u.items[i].code === c) return u.items[i]; return null; };
  var gq = 0, gv = 0, body2 = codes.map(function (c) { var g = 0, v = 0;
      var cells = units.map(function (u) { var it = find(u, c), t = it ? Number(it.q) : 0; g += t; v += it ? Number(it.v) : 0;
        return u.cols.map(function (s) { return '<td>' + q_(it && it.by[s] || 0) + '</td>'; }).join('') + '<td class="b" style="background:' + C_.sub + '">' + q_(t) + '</td>'; }).join('');
      gq += g; gv += v; return '<tr><td class="l">' + esc_(c) + '</td><td class="l">' + esc_(names[c]) + '</td>' + cells + '<td class="b">' + q_(g) + '</td><td>' + m2_(v) + '</td></tr>'; }).join('');
  var foot = '<tr class="grand"><td class="l" colspan="2">TOTAL</td>' + units.map(function (u) { return u.cols.map(function (s) { return '<td>' + q_(u.items.reduce(function (a, i) { return a + (Number(i.by[s]) || 0); }, 0)) + '</td>'; }).join('')
      + '<td>' + q_(u.items.reduce(function (a, i) { return a + Number(i.q); }, 0)) + '</td>'; }).join('') + '<td>' + q_(gq) + '</td><td>' + m2_(gv) + '</td></tr>';
  var p2 = '<div class="pg">' + head_('Salesman Wise Sales & Damage Report', '', 'Period: ' + per + ' | Values in AED') + '<div style="font-weight:700;font-size:14px;margin:0 0 6px">Damage by Item - Unit Wise</div>'
    + (codes.length ? '<table class="t" style="font-size:11.5px"><tr><th rowspan="2">Item Code</th><th rowspan="2">Item Desc</th>' + units.map(function (u) { return '<th colspan="' + (u.cols.length + 1) + '">' + unitName_(u.unit) + ' UNIT</th>'; }).join('')
        + '<th rowspan="2">Grand<br>Total</th><th rowspan="2">Damage<br>Value</th></tr><tr>' + units.map(function (u) { return u.cols.map(function (s) { return '<th>' + esc_(s) + '</th>'; }).join('') + '<th>' + unitName_(u.unit) + '<br>Total</th>'; }).join('') + '</tr>'
        + body2 + foot + '</table>' : '<p>No damage recorded.</p>') + '</div>';
  return { html: doc_(p1 + p2, true), G: G };
}

// ---------- 2. GRV VS DAMAGE, WASTE & EXPIRY ----------
function grvHtml_(D, units, per) {
  var z = function () { return { grv: 0, dmg: 0, wst: 0, exp: 0, gv: 0 }; }, add = function (a, m) { ['grv','dmg','wst','exp','gv'].forEach(function (f) { a[f] += Number(m[f]) || 0; }); return a; };
  var st = function (m) { var df = m.dmg + m.wst + m.exp - m.grv; return Math.abs(df) < 1e-9 ? '<span style="color:' + C_.green + '">&#10003; Matched</span>' : '<span style="color:' + C_.red + '">&#10007; ' + (m.grv === 0 ? 'No GRV' : df < 0 ? 'Short' : 'Excess') + '</span>'; };
  var row = function (m, lab, route, cls) { var t = m.dmg + m.wst + m.exp, df = t - m.grv;
    return '<tr' + (cls ? ' class="' + cls + '"' : '') + '><td class="l">' + esc_(lab) + '</td><td class="l">' + esc_(route || '') + '</td>' + [q_(m.grv), q_(m.dmg), q_(m.wst), q_(m.exp), q_(t)].map(function (v) { return '<td>' + v + '</td>'; }).join('')
      + '<td' + (Math.abs(df) < 1e-9 ? '' : ' class="r"') + '>' + sg_(df) + '</td><td>' + m2_(m.gv) + '</td><td class="l">' + (cls ? '' : st(m)) + '</td></tr>'; };
  var G = z(), diff = 0, body = units.map(function (u) { var T = z(), n = unitName_(u.unit);
    return '<tr class="band"><td colspan="10">' + n + ' UNIT</td></tr>' + (u.men.length ? u.men.map(function (m) { add(T, m); if (Math.abs(m.dmg + m.wst + m.exp - m.grv) > 1e-9) diff++; return row(m, m.name, m.route); }).join('') : '<tr><td colspan="10" class="l">No GRV, damage, waste or expiry.</td></tr>')
      + (add(G, T), row(T, n + ' SUB TOTAL', '', 'sub')); }).join('');
  var p1 = '<table style="width:100%;border-collapse:collapse;margin:0 0 10px"><tr><td style="width:90px"><img src="data:image/jpeg;base64,' + MJ_LOGO + '" style="height:54px"></td>'
    + '<td style="vertical-align:middle"><div style="font-size:20px;font-weight:700;color:' + C_.green + '">MAHRJAN GENERAL TRADING LLC</div><div style="font-size:20px;font-weight:700;color:' + C_.green + '">GRV VS DAMAGE, WASTE &amp; EXPIRY</div></td>'
    + '<td style="text-align:right;vertical-align:middle;font-weight:700;font-size:13px">' + esc_(per) + ' &middot; SALESMAN SUMMARY<br><span style="text-decoration:underline">Qty in PCS</span> &nbsp; Values in AED</td></tr></table>'
    + '<table class="t"><tr>' + ['SALESMAN','ROUTE','GRV','DAMAGE','WASTE','EXPIRY','TOTAL D+W+E','DIFFERENCE','GRV VALUE (AED)','STATUS'].map(function (h, i) { return '<th' + (i < 2 || i === 9 ? ' class="l"' : '') + '>' + h + '</th>'; }).join('') + '</tr>'
    + body + (units.length > 1 ? row(G, 'GRAND TOTAL', '', 'grand') : '') + '</table>'
    + '<p style="font-size:11px;color:#6b7370;margin:6px 0 14px">Difference = (Damage + Waste + Expiry) &minus; GRV. Minus (Short): GRV billed but less came back in the van. Plus (Excess): came back as damage / waste / expiry with no GRV billed. Item-wise lines follow below.</p>';
  var irow = function (m, a, b, cls) { var t = m.dmg + m.wst + m.exp, df = t - m.grv;
    return '<tr' + (cls ? ' class="' + cls + '"' : '') + '><td class="l">' + esc_(a) + '</td><td class="l">' + esc_(b) + '</td>' + [q_(m.grv), q_(m.dmg), q_(m.wst), q_(m.exp), q_(t)].map(function (v) { return '<td>' + v + '</td>'; }).join('') + '<td' + (Math.abs(df) < 1e-9 ? '' : ' class="r"') + '>' + sg_(df) + '</td></tr>'; };
  var blocks = units.map(function (u) { var by = {}, order = [];
    u.items.forEach(function (it) { if (!by[it.sm]) { by[it.sm] = []; order.push(it.sm); } by[it.sm].push(it); });
    return order.map(function (k) { var T = z(); by[k].forEach(function (it) { add(T, it); });
      return '<tr class="band"><td colspan="8">' + unitName_(u.unit) + ' &middot; ' + esc_(k) + '</td></tr>' + by[k].map(function (it) { return irow(it, it.code, it.name); }).join('') + irow(T, k + ' TOTAL', '', 'sub'); }).join(''); }).join('');
  var p2 = '<div style="font-size:15px;font-weight:700;color:' + C_.green + ';margin:6px 0">ITEM-WISE GRV, DAMAGE, WASTE &amp; EXPIRY (SALESMAN WISE)</div><table class="t"><tr>'
    + ['BARCODE','ITEM','GRV','DAMAGE','WASTE','EXPIRY','TOTAL D+W+E','DIFFERENCE'].map(function (h, i) { return '<th' + (i < 2 ? ' class="l"' : '') + '>' + h + '</th>'; }).join('') + '</tr>' + blocks + '</table>';
  return { html: doc_(p1 + p2, true), G: G, diff: diff };
}

// ---------- 3. DAILY SALES QTY (item × salesman, loading time) ----------
function qtyGridHtml_(D, units, per) {
  var items = D.items || [], cell = function (v, b) { return v ? '<td' + (b ? ' class="b"' : '') + '>' + q_(v) + '</td>' : '<td></td>'; }, pink = 'style="background:' + C_.pink + '"';
  var nmen = units.reduce(function (a, u) { return a + u.men.length + 1; }, 0) + 4;
