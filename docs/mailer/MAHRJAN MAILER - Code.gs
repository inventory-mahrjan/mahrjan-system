  var MO = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'], nd = function (iso) { if (!iso) return '—'; var q = String(iso).split('-'); return q[2] + '-' + MO[Number(q[1]) - 1] + '-' + q[0]; };
